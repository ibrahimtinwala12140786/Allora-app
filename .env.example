# Allora Environment Configuration Template (.env.example)
# Copy this file to `.env` and fill in your project values:
#   cp .env.example .env
#
# Then run your app with:
#   flutter run --dart-define-from-file=.env

# Supabase Configuration
SUPABASE_URL=https://your-supabase-url.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Matrix Homeserver Configuration
MATRIX_HOMESERVER_URL=https://matrix.allorachat.app
SYNAPSE_ADMIN_SECRET=your-synapse-secret

# Gemini / AI Testing API Key
GEMINI_API_KEY=your-gemini-api-key-here
